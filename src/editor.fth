( GENERAL SCREEN HANDLING )
: CLS 93 EMIT ;
: CHECK-STACK
  0 SP@ 0 3 <W IF
    CR ." STACK OVERFLOW" CR  FC SP!
  THEN
  0 SP@ 0 FC >=W IF
    CR ." STACK UNDERFLOW" CR  FC SP!
  THEN ;
: DROP-ALL FC SP! ;

FALSE VAR TEXT-MODIFIED
0 0 VARW TEXT-SIZE
0 0 VARW EDITOR-OFFSET

: LIST-LINE ( W:A -- W:A' )
  DUPW TEXT-BUFFER -W
  TEXT-SIZE =W SKIP
  @+ DUP EMIT
  0D = SKIP LIST-LINE ;
: LIST  0 TEXT-BUFFER
  BEGIN
    DUPW TEXT-BUFFER -W TEXT-SIZE =W IF
      DROPW DROP CR EXIT
    THEN
    ROT DUP . 1+ -ROT ." O "
    LIST-LINE
  AGAIN ;
: LIST-RAW  TEXT-BUFFER TEXT-SIZE TYPEW ;

: TOUCH-TEXT  TRUE TO TEXT-MODIFIED ;
: TEXT-START?  EDITOR-OFFSET 0=W ;
: TEXT-END?  EDITOR-OFFSET TEXT-SIZE =W ;
: TEXT@ ( -- C )
  EDITOR-OFFSET TEXT-BUFFER +W @ ;
: TEXT-CHAR>
  TEXT-END? SKIP
  EDITOR-OFFSET 1+W TOW EDITOR-OFFSET ;
: TEXT-EOL>
  TEXT-END? SKIP
  TEXT@ 0D = SKIP
  TEXT-CHAR> TEXT-EOL> ;
: TEXT-LINE>
  TEXT-EOL> TEXT-CHAR> ;
: TEXT-SEEK ( N -- )
  0 0 TOW EDITOR-OFFSET
  FOR TEXT-LINE> NEXT ;
: EDITOR-OFFSETS ( W:O1 W:O2 -- W:A1 W:A2 )
  >RW
  TEXT-BUFFER +W SWAPW
  TEXT-BUFFER +W SWAPW
  R>W ;
: DEL ( N -- )
  TEXT-SEEK EDITOR-OFFSET
  TEXT-LINE> EDITOR-OFFSET
  SWAPW
  OVERW OVERW -W >RW
  OVERW TEXT-SIZE SWAPW -W
  EDITOR-OFFSETS <MOVE
  TEXT-SIZE R>W -W TOW TEXT-SIZE
  TOUCH-TEXT ;
: INS ( W:A W:COUNT N -- )
  ( ASSUME INSERTED LINE ENDS WITH CR )
  TEXT-SEEK
  EDITOR-OFFSET  OVERW +W
  EDITOR-OFFSET  SWAPW
  OVERW TEXT-SIZE SWAPW -W
  EDITOR-OFFSETS MOVE>
  DUPW TEXT-SIZE +W TOW TEXT-SIZE
  EDITOR-OFFSET TEXT-BUFFER +W
  SWAPW <MOVE
  TOUCH-TEXT ;
( TODO: USE EOB? INPUT@ INPUT> ETC )
: REST-OF-LINE ( -- W:A W:COUNT )
  INPUT@W  BEGIN
    EOB? IF
      INPUT@W OVERW -W EXIT
    THEN
    INPUT@@ INPUT> 0D = IF
      INPUT@W OVERW -W EXIT
    THEN
  AGAIN ;
: O ( N -- )
  DUP >R DEL  REST-OF-LINE R> INS ;
: W ( N -- )
  >R REST-OF-LINE R> INS ;
: APPEND-CHAR ( C -- )
  TEXT-BUFFER TEXT-SIZE +W !
  TEXT-SIZE 1+W TOW TEXT-SIZE
  TOUCH-TEXT ;
: X ( -- )
  REST-OF-LINE
  DUPW 0=W IF  DROPW DROPW EXIT  THEN
  FORW @+ APPEND-CHAR NEXTW
  DROPW ;

: STATUS
  HERE@W ['] ,2 -W
  .W ." BYTES USED" CR ;
