: RAMDRIVE-N>ADR ( N -- W:A )
  RAMDRIVE-PAGE SWAP @ 0 ;
: RAMDRIVE-READ ( W:A N -- )
  RAMDRIVE-N>ADR SWAPW
  1 0 <MOVE-SHADOW ;
: RAMDRIVE-WRITE ( W:A N -- )
  RAMDRIVE-N>ADR
  1 0 <MOVE-SHADOW ;

: DUMPW ( W:A W:N -- )
  FORW DUPW @ .H SPACE 1+W NEXTW DROPW ;
: TYPEW ( W:A W:N -- )
  FORW DUPW @ EMIT 1+W NEXTW DROPW ;

ALLOC-PAGE 0 VARW COMPRESSED-BUFFER
: TEST-RAMDRIVE
  COMPRESSED-BUFFER 0 RAMDRIVE-READ
  COMPRESSED-BUFFER TEXT-BUFFER
  DUPW 2 FF +W UNCOMPRESS
  TEXT-BUFFER SWAPW OVERW -W TYPEW ;
