# BLOCK ADDRESSES ARE BIG-ENDIAN
# BYTE 0: 0 = BYTE 1 INDICATES DEVICE
#   OTHERWISE IPV4 ADDRESS BYTES 0-3
# BYTE 1: 0 = RAM DRIVE
: BLOCK-VARIABLE  CREATE 8 ALLOT ;
: !BLOCK ( W:SRC W:TRG -- ) 0 8 <MOVE ;

BLOCK-VARIABLE SCR
BLOCK-VARIABLE BLK
BLK 0 4 +W VARW BLK4
BLK 0 7 +W VARW BLK7
SCR 0 6 +W VARW SCR6

FALSE VAR SCR-VALID
CREATE BS-KEY 10 ALLOT

: SWAPD ( W:A -- )
  DUP>RW  @W  R@W 1+W 1+W @W
  SWAP R@W !W  SWAP R>W 1+W 1+W !W ;

# TODO: ELSEWHERE?
: ADD-SHADOW-RAM ( -- )
  FF D0 DO  I FREE-PAGE DROP  1 +LOOP ;
ADD-SHADOW-RAM

: RD-BLOCK-PAGE ( -- W:A )
  BLK7 @  RAMDRIVE-PAGE SWAP ;
: RD-READ ( W:A -- ERR? )
  RD-BLOCK-PAGE @ 0  SWAPW
  1 0 <MOVE-SHADOW
  FALSE ;
: RD-WRITE ( W:A -- ERR? )
  RD-BLOCK-PAGE @
  0= IF
    # TODO: HANDLE OOM
    ALLOC-PAGE RD-BLOCK-PAGE !
  THEN
  RD-BLOCK-PAGE @ 0  1 0 <MOVE-SHADOW
  FALSE ;

19 66 VARW BS-PORT

: BS-LOAD-REQ ( -- )
  BLK4  0 4  0 1  UDP-COPY-PAYLOAD
  PACKET-WRITE-BUF 0 1D +W SWAPD
  A0 PACKET-WRITE-BUF 0 1C +W !
  MY-IP  BLK  AB CD  BS-PORT  0 5
  UDP-CREATE-HEADER
  SLIP-WRITE-PACKET ;
: BS-LOAD-RX ( W:BUF -- ERR? )
  DUPW  FF  1 00  FILLW
  SLIP-RX
  SLIP-RX-STATE SLIP-STATE-DONE <> IF
    TRUE EXIT
  THEN
  # TODO: VERIFY LOAD RESPONSE
  PACKET-READ-BUF 0 21 +W
  SWAPW
  PACKET-READ-SIZE 0 21 -W
  <MOVE
  FALSE ;

: BS-PACK-SIZE ( -- W:SIZE )
  0 0   1 0 FORW
    PACKET-WRITE-BUF 0 31 +W
    1 0 IW -W  +W @
    FF <> IF
      DROPW 1 1 IW -W
    THEN
  NEXTW ;
: BS-STORE-REQ ( W:A -- )
  1 0  0 15  UDP-COPY-PAYLOAD
  BLK4  0 4  0 11 UDP-COPY-PAYLOAD
  PACKET-WRITE-BUF 0 2D +W SWAPD
  BS-KEY  0 10  0 1  UDP-COPY-PAYLOAD
  A2  PACKET-WRITE-BUF 0 1C +W  !
  MY-IP  BLK  AB CD  BS-PORT
  BS-PACK-SIZE  0 15  +W
  UDP-CREATE-HEADER
  SLIP-WRITE-PACKET ;
: BS-STORE-RX ( -- ERR? )
  SLIP-RX
  SLIP-RX-STATE SLIP-STATE-DONE <> IF
    TRUE EXIT
  THEN
  PACKET-READ-BUF 0 1C +W @ A3 <> IF
    TRUE EXIT
  THEN
  # TODO: VERIFY BLOCK# AND IP
  FALSE ;

: BS-READ ( W:A -- ERR? )
  BS-LOAD-REQ  BS-LOAD-RX ;
: BS-WRITE ( W:A -- ERR? )
  BS-STORE-REQ BS-STORE-RX ;

CREATE RD-STRUCT
  ' RD-READ ,2
  ' RD-WRITE ,2

CREATE BS-STRUCT
  ' BS-READ ,2
  ' BS-WRITE ,2

CREATE BLOCK-DEVICES
  RD-STRUCT ,2
  # TODO: MORE DEVICES

1 VAR MAX-BLOCK-DEVICES
0 0 VARW FN-READ
0 2 VARW FN-WRITE

: BLK>DEV ( -- W:DEV )
  BLK @ 0<> IF  BS-STRUCT EXIT  THEN
  BLK 1+W @  MAX-BLOCK-DEVICES >= IF
    ." INVALID BLK: " BLK 8 DUMP  CR
    0 0  EXIT
  THEN
  0  BLK 1+W @  2*
  BLOCK-DEVICES +W @W ;
: BLOCK-FN ( W:A W:IDX -- ERR? )
  BLK>DEV  0=W IF
    DROPW DROPW TRUE EXIT
  THEN
  BLK>DEV +W @W EXECUTE ;
: BLOCK-READ ( W:A -- ERR? )
  FN-READ BLOCK-FN ;
: BLOCK-WRITE ( W:A -- ERR? )
  FN-WRITE BLOCK-FN ;

: UNCOMPRESS-TEXT ( W:A -- )
  TEXT-BUFFER DUPW 2 FF +W UNCOMPRESS
  TEXT-BUFFER -W  TOW TEXT-SIZE ;
: COMPRESS-TEXT ( PAGE -- ERR? )
  >R  TEXT-BUFFER DUPW TEXT-SIZE +W
  R> COMPRESS ;

: SAVE ( -- )
  SCR-VALID NOT IF
    ." NO SCREEN OPEN" CR EXIT
  THEN
  TEXT-MODIFIED SO
  ALLOC-PAGE DUP
  COMPRESS-TEXT IF
    FREE-PAGE
    ." COMPRESS ERROR" CR EXIT
  THEN
  DUP 0
  SCR BLK !BLOCK
  BLOCK-WRITE IF
    FREE-PAGE
    ." WRITE ERROR" CR EXIT
  THEN
  FREE-PAGE ;
: RELOAD
  FALSE TO TEXT-MODIFIED
  ALLOC-PAGE
  DUP 0
  SCR BLK !BLOCK
  BLOCK-READ IF
    FREE-PAGE ." READ ERROR" EXIT
  THEN
  DUP 0 UNCOMPRESS-TEXT
  FREE-PAGE
  TRUE TO SCR-VALID ;
: +SCR ( N -- )
  0 SWAP  SCR6 @W
  SWAP +W SWAP  SCR6 !W ;
: -SCR ( N -- )
  0 SWAP  SCR6 @W
  SWAP -W SWAP  SCR6 !W ;
: DISCARD ( -- )
  FALSE TO TEXT-MODIFIED
  FALSE TO SCR-VALID ;
: EMPTY ( -- )
  0 TOW TEXT-SIZE
  TRUE TO SCR-VALID
  FALSE TO TEXT-MODIFIED ;
: RUN ( -- )
  TEXT-BUFFER  DUPW TEXT-SIZE +W
  INTERPRET ;
: LOADS ( N -- )
  FOR
    DISCARD RELOAD RUN
    1 +SCR
  NEXT ;
: HEX ( W:A N -- )
  FOR
    CHAR C>HEX 4 <<  CHAR C>HEX  +  !+
  NEXT DROPW ;
: BLOCK# ( W:A -- ) 8 HEX ;
: GO# ( -- ) DISCARD  SCR BLOCK#  RELOAD LIST-RAW ;
