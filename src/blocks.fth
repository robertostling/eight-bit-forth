: ADD-SHADOW-RAM ( -- )
  FF D0 DO  I FREE-PAGE DROP  1 +LOOP ;
ADD-SHADOW-RAM

: RAMDRIVE-BLOCK-ADR ( W:NA -- W:A )
  @  RAMDRIVE-PAGE SWAP ;
: RAMDRIVE-READ ( W:A W:NA -- ERR? )
  RAMDRIVE-BLOCK-ADR @ 0 SWAPW
  1 0 <MOVE-SHADOW
  FALSE ;
: RAMDRIVE-WRITE ( W:A W:NA -- ERR? )
  RAMDRIVE-BLOCK-ADR DUPW @
  0= IF
    ALLOC-PAGE DUP >R -ROT ! R>
  THEN
  0
  1 0 <MOVE-SHADOW
  FALSE ;

19 66 VARW BS-PORT
: BS-LOAD-REQUEST ( W:IP W:BLOCK# -- )
  0 4  0 1  UDP-COPY-PAYLOAD
  A0 PACKET-WRITE-BUF 0 1C +W !
  MY-IP SWAPW  AB CD  BS-PORT  0 5
  UDP-CREATE-HEADER
  SLIP-WRITE-PACKET ;
: BS-LOAD-RX ( W:BUF -- ERR? )
  DUPW  FF  1 00  FILLW
  SLIP-RX
  SLIP-RX-STATE SLIP-STATE-DONE <> IF
    TRUE EXIT
  THEN
  ( TODO: VERIFY LOAD RESPONSE )
  PACKET-READ-BUF 0 21 +W
  SWAPW
  PACKET-READ-SIZE 0 21 -W
  <MOVE
  FALSE ;
: BS-LOAD ( W:BUF W:IP W:BLOCK# -- ERR? )
  BS-LOAD-REQUEST  BS-LOAD-RX ;

CREATE BS-KEY 10 ALLOT
: BS-PACK-SIZE ( -- W:SIZE )
  0 0   1 0 FORW
    PACKET-WRITE-BUF 0 31 +W
    1 0 IW -W  +W @
    FF <> IF
      DROPW 1 1 IW -W
    THEN
  NEXTW ;
: BS-STORE-REQUEST ( W:BUF W:IP W:BLOCK# -- )
  0 4  0 11  UDP-COPY-PAYLOAD
  SWAPW
  1 0  0 15  UDP-COPY-PAYLOAD
  BS-KEY  0 10  0 1  UDP-COPY-PAYLOAD
  A2  PACKET-WRITE-BUF 0 1C +W  !
  MY-IP SWAPW  AB CD  BS-PORT
  BS-PACK-SIZE  0 15  +W
  UDP-CREATE-HEADER
  SLIP-WRITE-PACKET ;
: BS-STORE-RX ( -- ERR? )
  SLIP-RX
  SLIP-RX-STATE SLIP-STATE-DONE <> IF
    TRUE EXIT
  THEN
  PACKET-READ-BUF 0 1C +W @ A3 <> IF
    TRUE EXIT
  THEN
  ( TODO: VERIFY BLOCK# )
  FALSE ;
: BS-STORE ( W:BUF W:IP W:BLOCK# -- ERR? )
  BS-STORE-REQUEST BS-STORE-RX ;

VPS-IP VARW BS-IP
CREATE BS-BLOCK# 4 ALLOT
: BS-READ ( W:A W:NA -- ERR? )
  BS-BLOCK#  0 3  <MOVE
  BS-IP BS-BLOCK# BS-LOAD ;
: BS-WRITE ( W:A W:NA -- ERR? )
  BS-BLOCK#  0 3  <MOVE
  BS-IP BS-BLOCK# BS-STORE ;

CREATE RAMDRIVE-STRUCT
  ' RAMDRIVE-READ ,2
  ' RAMDRIVE-WRITE ,2

CREATE BS-STRUCT
  ' BS-READ ,2
  ' BS-WRITE ,2

CREATE BLOCK-DEVICES
  RAMDRIVE-STRUCT ,2
  BS-STRUCT ,2

2 VAR MAX-BLOCK-DEVICES
0 0 VARW FN-READ
0 2 VARW FN-WRITE

: BLOCK>DEVICE ( W:NA -- W:DEV-STRUCT )
  0 3 +W @ DUP
  MAX-BLOCK-DEVICES >= IF
    ." INVALID DEVICE: " .
    0 0 EXIT
  THEN
  2* 0 SWAP BLOCK-DEVICES +W @W ;
: BLOCK-FN ( W:IDX W:NA -- ERR? )
  BLOCK>DEVICE
  DUPW 0=W IF
    ( FIXME: ARGS LEFT ON STACK )
    DROPW DROPW TRUE EXIT
  THEN
  +W @W EXECUTE ;
: BLOCK-READ ( W:A W:NA -- ERR? )
  FN-READ OVERW BLOCK-FN ;
: BLOCK-WRITE ( W:A W:NA -- ERR? )
  FN-WRITE OVERW BLOCK-FN ;

( TODO: ASM TO CORE.FTH AROUND CHAR )


# NOTES:
# - LOAD/THRU REQUIRES RELOADING TEXT-BUFFER AGAIN ON RETURN
# - IMPLEMENT STACK WITH BLOCK# + CHAR POSITION
# - WORDS FOR MANAGING BLOCKS:
# SCR -- VARIABLE CONTAINING BLOCK IN TEXT-BUFFER
# WORDS TO MODIFY SCR AND DECOMPRESS BLOCK INTO TEXT-BUFFER:
# NB ( -- ) - NEXT BLOCK
# LB ( -- ) - LAST BLOCK
# ...
# SAVE ( -- ) - COMPRESS TEXT-BUFFER AND WRITE TO SCR
#  CONSIDER AUTO-SAVE IF COMPRESSION IS EFFICIENT
# DISCARD ( -- ) - LOAD SCR TO TEXT-BUFFER, IGNORE OLD CONTENTS
# FLUSH ( -- ) - WRITE ALL DIRTY BLOCKS
#
# RAM DRIVE BLOCKS SHOULD BYPASS CACHE
#
# COMMON BLOCK CACHE AS ARRAY OF:
#  4 BYTES - BLOCK#
#  1 BYTE - PAGE
#  1 BYTE - STATUS (UNUSED, CLEAN, DIRTY)
# USE 1-BYTE HASH TO MAP BLOCK TO CACHE SLOTS

: UNCOMPRESS-TEXT ( W:A -- )
  TEXT-BUFFER DUPW 2 FF +W UNCOMPRESS
  TEXT-BUFFER -W  TOW TEXT-SIZE ;
: COMPRESS-TEXT ( PAGE -- ERR? )
  >R  TEXT-BUFFER DUPW TEXT-SIZE +W
  R> COMPRESS ;

: BLOCK-VARIABLE  CREATE 4 ALLOT ;

BLOCK-VARIABLE SCR-BLOCK
FALSE VAR SCR-VALID

: SAVE ( -- )
  SCR-VALID NOT IF
    ." NO SCREEN OPEN" CR EXIT
  THEN
  TEXT-MODIFIED SO
  ALLOC-PAGE DUP
  COMPRESS-TEXT IF
    FREE-PAGE
    ." COMPRESS ERROR" CR EXIT
  THEN
  DUP 0 SCR-BLOCK
  BLOCK-WRITE IF
    FREE-PAGE
    ." WRITE ERROR" CR EXIT
  THEN
  FREE-PAGE ;
: RELOAD
  FALSE TO TEXT-MODIFIED
  ALLOC-PAGE
  DUP 0 SCR-BLOCK
  BLOCK-READ IF
    FREE-PAGE ." READ ERROR" EXIT
  THEN
  DUP 0 UNCOMPRESS-TEXT
  FREE-PAGE
  TRUE TO SCR-VALID ;
: GO ( A B C D -- )
  SCR-VALID IF SAVE THEN
  SCR-BLOCK 4 !NL
  RELOAD ;
: DISCARD
  FALSE TO TEXT-MODIFIED
  FALSE TO SCR-VALID ;
: RUN ( -- )
  TEXT-BUFFER  DUPW TEXT-SIZE +W
  INTERPRET ;
