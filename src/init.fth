ALLOC-PAGE 0 VARW TEST-BUF
CREATE BLOCK# 4 ALLOT

: BLOCK#! ( A B C D -- )
  BLOCK# 4 !N ;

: INTERPRET-LINE
  COUNTW OVERW +W INTERPRET ;
: REPL BEGIN
    ."  OK" CR
    KERNAL-READ-LINE
    18 0 CURSOR! CR
    ( ." <" KERNAL-LINE-BUF COUNT TYPE ." >" CR )
    KERNAL-LINE-BUF INTERPRET-LINE
  AGAIN ;

: TEST-READ
  1 0 0 0 BLOCK#!
  TEST-BUF BLOCK# BLOCK-READ
  NOT IF
    TEST-BUF UNCOMPRESS-BLOCK
    ." TEXT-SIZE = " TEXT-SIZE .W CR
    TEXT-BUFFER TEXT-SIZE TYPEW
  ELSE
    ." BLOCK-READ FAILED" CR
  THEN ;

S" SILLYPASSWORD123" COUNT DROP
BS-KEY  0 10 <MOVE

: TEST-WRITE
  1 0 0 1 BLOCK#!
  TEST-BUF BLOCK# BLOCK-WRITE
  IF  ." BLOCK-WRITE FAILED" CR  THEN
  ;

: TEST-COMPRESS
  TEXT-BUFFER DUPW TEXT-SIZE +W
  TEST-BUF DROP
  COMPRESS IF ." COMPRESS FAILED" THEN ;

SERIAL-INIT
CR .( INITIALIZED RS-232) CR
SUNET-IP PING
SUNET-IP PING
REPL

