KERNEL-SOURCE ACTIVE

CREATE FN-SERIAL  2 , 8 , 0 ,
FN-SERIAL KERNAL-SETNAM
2 2 0 KERNAL-SETLFS
KERNAL-OPEN

: SERIAL-EMIT
  2 KERNAL-CHKOUT  EMIT  0 KERNAL-CHKOUT ;
: SERIAL-KEY
  BEGIN
    02 9B @  02 9C @  <>
  UNTIL
  KERNAL-GETIN ;
: SLIP-ESC
  DUP DB = IF
    SERIAL-KEY
    DUP DC = IF
      DROP C0 EXIT
    THEN
    DUP DD = IF
      DROP DB EXIT
    THEN
    ." ERR " .H
  THEN ;
: SLIP-READ
  2 KERNAL-CHKIN
  0
  BEGIN
    SERIAL-KEY
    DUP C0 = IF
      DROP  0 KERNAL-CHKIN  EXIT
    THEN
    SLIP-ESC .H SPACE
    1+ DUP 8 = IF  DROP 0 CR  THEN
  AGAIN
  0 KERNAL-CHKIN ;

: TERMINAL BEGIN
  KERNAL-KEY DUP EMIT SERIAL-EMIT
  AGAIN ;

: SLIP-TEST
  ." CONFIG: " 02 93 @ .H CR
  BEGIN
    CR ." WAITING FOR PACKET" CR
    SLIP-READ
  AGAIN ;

SLIP-TEST

( TERMINAL )

( EDITOR )
